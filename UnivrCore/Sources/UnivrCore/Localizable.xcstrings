    },
    "v0_7-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings have a completely new look with icons for each item and better organization. An Info section has been added with the app version, credits and contributors. Course search now has a scrollable list with a close button and app reset requires confirmation to prevent accidents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Le impostazioni hanno un look completamente nuovo con icone per ogni voce e una migliore organizzazione. È stata aggiunta la sezione Info con la versione dell'app, i crediti e i contributori. La ricerca dei corsi ora ha una lista scorrevole con pulsante di chiusura e il reset dell'app richiede una conferma per evitare errori."
          }
        }
      }
    },
    "v0_7-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New icons, Info section with version and credits, and reset confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nuove icone, sezione Info con versione e crediti, e conferma reset."
          }
        }
      }
    },
    "v0_7-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesigned Settings"
          }
        },
        "it" : {
