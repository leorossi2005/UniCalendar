    },
    "v0_1-00-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univr Calendar launches with everything you need to get going: a main screen showing the day's classes, a guided onboarding to choose your academic year and degree program, and settings to change your preferences at any time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Univr Calendar nasce con tutto il necessario per partire: una schermata principale che mostra le lezioni del giorno, un onboarding guidato per scegliere anno accademico e corso di laurea, e le impostazioni per cambiare le tue preferenze in qualsiasi momento."
          }
        }
      }
    },
    "v0_1-00-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View your daily classes, choose your course and get started right away."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Visualizza le tue lezioni del giorno, scegli il corso e inizia subito."
          }
        }
      }
    },
    "v0_1-00-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introducing Univr Calendar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nasce Univr Calendar"
          }
        }
      }
    },
    "v0_1-01-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The new Calendar button in the bottom bar behaves smartly: it opens when you scroll back to the top, closes when you scroll down and reopens when you move to the next day. So you always have the right information at the right time."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Il nuovo pulsante Calendario nella barra in basso si comporta in modo intelligente: si apre quando torni in cima alla lista, si chiude quando scorri verso il basso e si riapre quando passi al giorno successivo. Così hai sempre le informazioni giuste al momento giusto."
          }
        }
      }
    },
    "v0_1-01-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens and closes automatically as you scroll through classes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Si apre e chiude in automatico mentre scorri le lezioni."
          }
        }
      }
    },
    "v0_1-01-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar Button"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pulsante Calendario"
          }
        }
      }
    },
    "v0_1-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more scrolling through the entire list: just type the course name and the list filters instantly. Available both during initial setup and in settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Non devi più scorrere l'intera lista: basta digitare il nome del corso e la lista si filtra istantaneamente. Disponibile sia durante la configurazione iniziale sia nelle impostazioni."
          }
        }
      }
    },
    "v0_1-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find your course in an instant with the search bar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Trova il tuo corso in un attimo con la barra di ricerca."
          }
        }
      }
    },
    "v0_1-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course Search"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ricerca Corsi"
          }
        }
      }
    },
    "v0_1-03-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app automatically detects whether your course distinguishes between odd and even student IDs. If not, the page is skipped in onboarding and hidden in settings, making everything simpler and faster."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'app rileva automaticamente se il tuo corso prevede la distinzione tra matricole pari e dispari. Se non serve, la pagina viene saltata nell'onboarding e nascosta nelle impostazioni, rendendo tutto più semplice e veloce."
          }
        }
      }
    },
    "v0_1-03-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The odd/even student ID option only appears when required."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La scelta pari/dispari della matricola appare solo quando il corso lo richiede."
          }
        }
      }
    },
    "v0_1-03-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Student ID"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Matricola Intelligente"
          }
        }
      }
    },
    "v0_1-04-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Years, courses and academic years are downloaded once and shared across all screens. Settings no longer reload data if it's already available, making navigation smoother and reducing wait times."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Anni, corsi e anni accademici vengono scaricati una volta e condivisi tra tutte le schermate. Le impostazioni non ricaricano più i dati se sono già disponibili, rendendo la navigazione più fluida e riducendo i tempi di attesa."
          }
        }
      }
    },
    "v0_1-04-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data is loaded once and reused everywhere."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I dati vengono caricati una sola volta e riutilizzati ovunque."
          }
        }
      }
    },
    "v0_1-04-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faster Loading"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Caricamenti Più Veloci"
          }
        }
      }
    },
    "v0_1-05-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Fixed an issue that prevented viewing classes from previous years\n• Fixed a filter error that hid some classes for courses without student ID distinction\n• Improved light theme support in the loading indicator\n• Improved compatibility with different screen sizes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Corretto un problema che impediva di visualizzare le lezioni degli anni precedenti\n• Risolto un errore nel filtro che nascondeva alcune lezioni per corsi senza distinzione matricola\n• Migliorato il supporto al tema chiaro nell'indicatore di caricamento\n• Migliorata la compatibilità con diverse dimensioni di schermo"
          }
        }
      }
    },
    "v0_1-05-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Various bugs fixed and stability improvements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Vari bug risolti e miglioramenti di stabilità."
          }
        }
      }
    },
    "v0_1-05-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improvements and Fixes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Miglioramenti e Correzioni"
          }
        }
      }
    },
    "v0_1-headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is born, it all starts here"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nasce l'app, tutto parte da qui"
          }
        }
      }
    },
    "v0_2-00-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now navigate between days directly from the main screen with a left or right swipe. Each day shows its classes, breaks and a message if there are no classes. The entire academic year is ready to browse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ora puoi navigare tra i giorni direttamente dalla schermata principale con uno swipe a destra o sinistra. Ogni giorno mostra le sue lezioni, le pause e un messaggio se non ci sono lezioni. Tutto l'anno accademico è già pronto per essere sfogliato."
          }
        }
      }
    },
    "v0_2-00-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Switch from one day to another with a horizontal swipe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Passa da un giorno all'altro con uno swipe orizzontale."
          }
        }
      }
    },
    "v0_2-00-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe Between Days"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scorri tra i Giorni"
          }
        }
      }
    },
    "v0_2-01-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system calendar has been replaced with a custom one designed to better fit the app. You can navigate between months and select any day more quickly and intuitively."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Il calendario di sistema è stato sostituito con uno personalizzato, pensato per adattarsi meglio all'app. Puoi navigare tra i mesi e selezionare qualsiasi giorno in modo più rapido e intuitivo."
          }
        }
      }
    },
    "v0_2-01-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new monthly calendar replaces the system one."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Un nuovo calendario mensile sostituisce quello di sistema."
          }
        }
      }
    },
    "v0_2-01-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom Calendar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Calendario Personalizzato"
          }
        }
      }
    },
    "v0_2-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All network functions have been rewritten with async/await and Task, replacing the old callback system. The result is more stable and responsive loading, with clearer error handling."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tutte le funzioni di rete sono state riscritte con async/await e Task, sostituendo il vecchio sistema a callback. Il risultato è un caricamento più stabile e reattivo, con una gestione degli errori più chiara."
          }
        }
      }
    },
    "v0_2-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Network calls now use async/await for greater reliability."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Le chiamate di rete ora usano async/await per una maggiore affidabilità."
          }
        }
      }
    },
    "v0_2-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modern Networking"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rete più Moderna"
          }
        }
      }
    },
    "v0_2-03-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Added numerous utilities for working with dates more easily\n• Removed SwiftData from the project, no longer needed\n• Renamed model file for a clearer structure\n• Added a unique identifier to lessons\n• Fixed several bugs in navigation and the calendar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Aggiunte numerose utility per lavorare con le date in modo più semplice\n• Rimosso SwiftData dal progetto, non più necessario\n• Rinominato il file dei modelli per una struttura più chiara\n• Aggiunto un identificativo univoco alle lezioni\n• Corretti diversi bug nella navigazione e nel calendario"
          }
        }
      }
    },
    "v0_2-03-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal reorganization and various bugs fixed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Riorganizzazione interna e vari bug risolti."
          }
        }
      }
    },
    "v0_2-03-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improvements and Fixes"
          }
        },
        "it" : {
          "stringUnit" : {
