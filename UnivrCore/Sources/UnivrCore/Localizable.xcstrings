    "Prima Icona dell'App" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "First App Icon"
          }
        }
      }
    },
    "Pulsante Calendario" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar Button"
          }
        }
      }
    },
    "Rete migliorata, file riorganizzati e vari fix." : {
