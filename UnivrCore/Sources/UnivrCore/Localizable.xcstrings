    },
    "Ricerca Corsi" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course Search"
          }
        }
      }
    },
    "Riorganizzazione interna e vari bug risolti." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal reorganization and various bugs fixed."
          }
        }
      }
    },
    "Scorri i giorni e nuovo calendario" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe through days and new calendar"
          }
        }
      }
    },
    "Scorri le Settimane" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe Through Weeks"
          }
        }
      }
    },
    "Scorri tra i Giorni" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe Between Days"
          }
        }
      }
    },
    "Selezione Corso Ridisegnata" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesigned Course Selection"
          }
        }
      }
    },
    "Sezione Donazioni" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donations Section"
          }
        }
      }
    },
    "Sheet personalizzate, animazioni fluide ed effetti liquid glass." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom sheets, smooth animations and liquid glass effects."
          }
        }
      }
    },
    "Si apre e chiude in automatico mentre scorri le lezioni." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens and closes automatically as you scroll through classes."
          }
        }
      }
    },
    "Splash Screen Animato" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animated Splash Screen"
          }
        }
      }
    },
    "Supporta lo sviluppatore con una donazione direttamente dall'app." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support the developer with a donation directly from the app."
          }
        }
      }
    },
    "Supporto iOS 17 e 18" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 17 and 18 Support"
          }
        }
      }
    },
    "Supporto Nativo per iPad" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native iPad Support"
          }
        }
      }
    },
    "Tocca una lezione per vedere tutte le informazioni e la mappa dell'aula." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a lesson to see all the information and the classroom map."
          }
        }
      }
    },
    "Trova il tuo corso in un attimo con la barra di ricerca." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find your course in an instant with the search bar."
          }
        }
      }
    },
    "Tutte le funzioni di rete sono state riscritte con async/await e Task, sostituendo il vecchio sistema a callback. Il risultato è un caricamento più stabile e reattivo, con una gestione degli errori più chiara." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All network functions have been rewritten with async/await and Task, replacing the old callback system. The result is more stable and responsive loading, with clearer error handling."
          }
        }
      }
    },
    "Un nuovo calendario mensile sostituisce quello di sistema." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new monthly calendar replaces the system one."
          }
        }
      }
    },
    "Una nuova schermata introduttiva apre l'onboarding." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new introductory screen opens the onboarding."
          }
        }
      }
    },
    "Univr Calendar ha finalmente la sua icona personalizzata." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univr Calendar finally has its own custom icon."
          }
        }
      }
    },
    "Univr Calendar nasce con tutto il necessario per partire: una schermata principale che mostra le lezioni del giorno, un onboarding guidato per scegliere anno accademico e corso di laurea, e le impostazioni per cambiare le tue preferenze in qualsiasi momento." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univr Calendar launches with everything you need to get going: a main screen showing the day's classes, a guided onboarding to choose your academic year and degree program, and settings to change your preferences at any time."
          }
        }
      }
    },
    "Univr Calendar ora è completamente ottimizzato per iPad! Goditi un'esperienza fluida con layout adattivi, split view per visualizzare le settimane in landscape e interfaccia pensata appositamente per schermi più grandi. Ogni elemento è stato ripensato per sfruttare al meglio lo spazio disponibile." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univr Calendar is now fully optimized for iPad! Enjoy a smooth experience with adaptive layouts, split view to browse weeks in landscape and an interface designed specifically for larger screens. Every element has been rethought to make the most of the available space."
          }
        }
      }
    },
    "Vari bug risolti e miglioramenti di stabilità." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Various bugs fixed and stability improvements."
          }
        }
      }
    },
    "Visualizza le tue lezioni del giorno, scegli il corso e inizia subito." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "View your daily classes, choose your course and get started right away."
          }
        }
      }
    }
  },
  "version" : "1.1"
}