          }
        }
      }
    },
    "v0_3-00-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onboarding now starts with a welcome page that introduces the app and its purpose. A more welcoming way to guide you through initial setup, with the possibility of a dedicated animation in the future."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'onboarding ora inizia con una pagina di benvenuto che presenta l'app e il suo scopo. Un modo più accogliente per guidarti nella configurazione iniziale, con la possibilità in futuro di includere un'animazione dedicata."
          }
        }
      }
    },
    "v0_3-00-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A new introductory screen opens the onboarding."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Una nuova schermata introduttiva apre l'onboarding."
          }
        }
      }
    },
    "v0_3-00-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome Page"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pagina di Benvenuto"
          }
        }
      }
    },
    "v0_3-01-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the compact calendar at the bottom you can now swipe left or right to go to the previous or next week. The first day of the new week is selected automatically."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nel calendario compatto in basso puoi ora scorrere a sinistra o a destra per passare alla settimana precedente o successiva. Il primo giorno della nuova settimana viene selezionato automaticamente."
          }
        }
      }
    },
    "v0_3-01-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change week with a swipe from the compact calendar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cambia settimana con uno swipe dal calendario compatto."
          }
        }
      }
    },
    "v0_3-01-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe Through Weeks"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Scorri le Settimane"
          }
        }
      }
    },
    "v0_3-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app has been restructured with the MVVM pattern: lesson loading, data organization and networking logic are now handled by dedicated ViewModels for the calendar, onboarding and settings."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'app è stata ristrutturata con il pattern MVVM: la logica di caricamento lezioni, organizzazione dati e rete è ora gestita da ViewModel dedicati per il calendario, l'onboarding e le impostazioni."
          }
        }
      }
    },
    "v0_3-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logic and interface are now completely separated."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Logica e interfaccia ora sono completamente separate."
          }
        }
      }
    },
    "v0_3-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MVVM Architecture"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Architettura MVVM"
          }
        }
      }
    },
    "v0_3-03-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is now backward compatible with iOS 17 and 18 thanks to dedicated fallbacks for the latest components. Button styles, visual effects and layouts adapt automatically to the system version."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'app è ora retrocompatibile con iOS 17 e 18 grazie a fallback dedicati per i componenti più recenti. Stili dei pulsanti, effetti visivi e layout si adattano automaticamente alla versione del sistema."
          }
        }
      }
    },
    "v0_3-03-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extended compatibility with previous iOS versions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Compatibilità estesa alle versioni precedenti di iOS."
          }
        }
      }
    },
    "v0_3-03-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 17 and 18 Support"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Supporto iOS 17 e 18"
          }
        }
      }
    },
    "v0_3-04-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Improved JSON parsing of network responses for greater reliability\n• Reorganized all files into dedicated folders (App, Core, UI)\n• Views have been separated into individual files for easier management\n• Extensions have been split between logic and UI to facilitate future migrations\n• Fixed numerous bugs in navigation and loading"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Migliorato il parsing JSON delle risposte di rete per una maggiore affidabilità\n• Riorganizzati tutti i file in cartelle dedicate (App, Core, UI)\n• Le viste sono state separate in file distinti per una gestione più semplice\n• Le estensioni sono state divise tra logica e UI per facilitare future migrazioni\n• Corretti numerosi bug nella navigazione e nel caricamento"
          }
        }
      }
    },
    "v0_3-04-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved networking, reorganized files and various fixes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rete migliorata, file riorganizzati e vari fix."
          }
        }
      }
    },
    "v0_3-04-title" : {
      "extractionState" : "manual",
      "localizations" : {
