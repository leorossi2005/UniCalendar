            "value" : "Miglioramenti e Correzioni"
          }
        }
      }
    },
    "v0_5-headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesson details and blazing fast speed"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Dettagli lezione e velocità al top"
          }
        }
      }
    },
    "v0_6-00-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lesson names are now intelligently formatted: words like \"Laboratory\" or \"Theory\" become colored tags below the name, parentheses and technical info are extracted and simplified. The result is a shorter name that's readable at a glance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I nomi delle lezioni vengono ora formattati in modo intelligente: parole come \"Laboratorio\" o \"Teoria\" diventano tag colorati sotto il nome, le parentesi e le informazioni tecniche vengono estratte e semplificate. Il risultato è un nome più corto e leggibile a colpo d'occhio."
          }
        }
      }
    },
    "v0_6-00-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course names are automatically shortened and display useful tags."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I nomi dei corsi vengono abbreviati automaticamente e mostrano tag utili."
          }
        }
      }
    },
    "v0_6-00-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simplified Lesson Names"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nomi Lezioni Semplificati"
          }
        }
      }
    },
    "v0_6-01-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each lesson card has a completely new look: start time and duration on the left, course name, classroom and tags on the right. The gradient has been replaced by a solid color from the university, for a cleaner and more consistent look."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La scheda di ogni lezione ha un aspetto completamente nuovo: l'orario di inizio e la durata sono a sinistra, il nome del corso, l'aula e i tag a destra. Il gradiente è stato sostituito da un colore pieno proveniente dall'università, per un look più pulito e coerente."
          }
        }
      }
    },
    "v0_6-01-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New layout with time on the left, details on the right and colored tags."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nuovo layout con orario a sinistra, dettagli a destra e tag colorati."
          }
        }
      }
    },
    "v0_6-01-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesigned Lesson Card"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Card Lezione Ridisegnata"
          }
        }
      }
    },
    "v0_6-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app now has a dedicated icon with a design featuring a calendar and magnifying glass, designed to be recognizable right from the device's home screen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'app ha ora un'icona dedicata con un design che richiama il calendario e la lente d'ingrandimento, pensata per essere riconoscibile fin dalla schermata principale del dispositivo."
          }
        }
      }
    },
    "v0_6-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univr Calendar finally has its own custom icon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Univr Calendar ha finalmente la sua icona personalizzata."
          }
        }
      }
    },
    "v0_6-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
