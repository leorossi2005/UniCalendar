    "v0_7-00-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every text in the app has been translated: from onboarding to settings, from error messages to lesson details. The language adapts automatically to the device setting, so the experience feels natural from the very first launch."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Ogni testo dell'app è stato tradotto: dall'onboarding alle impostazioni, dai messaggi di errore ai dettagli delle lezioni. La lingua si adatta automaticamente a quella impostata sul dispositivo, così l'esperienza è naturale fin dal primo avvio."
          }
        }
      }
    },
    "v0_7-00-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app is now fully translated into Italian and English."
