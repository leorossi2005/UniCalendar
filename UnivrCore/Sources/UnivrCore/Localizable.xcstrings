          }
        }
      }
    },
    "v0_8-headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donations, new search and speed"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Donazioni, nuova ricerca e velocità"
          }
        }
      }
    },
    "v0_9-00-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Univr Calendar is now fully optimized for iPad! Enjoy a smooth experience with adaptive layouts, split view to browse weeks in landscape and an interface designed specifically for larger screens. Every element has been rethought to make the most of the available space."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Univr Calendar ora è completamente ottimizzato per iPad! Goditi un'esperienza fluida con layout adattivi, split view per visualizzare le settimane in landscape e interfaccia pensata appositamente per schermi più grandi. Ogni elemento è stato ripensato per sfruttare al meglio lo spazio disponibile."
          }
        }
      }
    },
    "v0_9-00-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimized experience for large screens with adaptive layouts and split view."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Esperienza ottimizzata per schermi grandi con layout adattivi e split view."
          }
        }
      }
    },
    "v0_9-00-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Native iPad Support"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Supporto Nativo per iPad"
          }
        }
      }
    },
    "v0_9-01-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No more worrying about connectivity! The app detects in real time when you're offline and notifies you with a dedicated indicator, letting you browse saved classes. Onboarding and settings lock automatically without a network. As soon as you're back online, everything syncs in the background without any action on your part."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Niente più preoccupazioni per la connessione! L'app rileva in tempo reale quando sei offline e ti avvisa con un indicatore dedicato, permettendoti di consultare le lezioni salvate. L'onboarding e le impostazioni si bloccano automaticamente senza rete. Appena torni online, tutto si sincronizza in background senza alcun intervento da parte tua."
          }
        }
      }
    },
    "v0_9-01-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your classes even without a connection, with automatic sync."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Consulta le tue lezioni anche senza connessione, sincronizzazione automatica."
          }
        }
      }
    },
    "v0_9-01-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline Mode"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Modalità Offline"
          }
        }
      }
    },
    "v0_9-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System sheets have been replaced by a fully custom sheet built with UIKit, offering advanced gestures, dynamic Liquid Glass effects and total control over animations. On iPad, the sheet's corner radius automatically adapts to the window position. The result? An even more beautiful and enjoyable app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Le sheet di sistema sono state sostituite da una sheet completamente personalizzata, costruita con UIKit, che offre gesture avanzate, effetti Liquid Glass dinamici e un controllo totale sulle animazioni. Su iPad il corner radius della sheet si adatta automaticamente alla posizione della finestra. Il risultato? Un'app ancora più bella e piacevole da usare."
          }
        }
      }
    },
    "v0_9-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Custom sheets, smooth animations and Liquid Glass effects."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sheet personalizzate, animazioni fluide ed effetti Liquid Glass."
          }
        }
      }
    },
    "v0_9-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesigned Interface"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Interfaccia Rinnovata"
          }
        }
      }
    },
    "v0_9-03-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• New style for cancelled classes with border and strikethrough text\n• Hover effects on iPad for more natural interaction\n• Completely redesigned date and time pickers with improved performance\n• Classroom map now static for greater stability and speed\n• Fixed numerous bugs with custom sheet on iOS 17 and 18\n• Optimized support for iOS 17, 18 and iPadOS\n• Redesigned lesson details with improved layout\n• Overall performance significantly improved"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Nuovo stile per le lezioni cancellate con bordo e testo barrato\n• Hover effects su iPad per un'interazione più naturale\n• Picker data e ora completamente ridisegnati con performance migliorate\n• Mappa dell'aula ora statica per maggiore stabilità e velocità\n• Risolti numerosi bug con la sheet personalizzata su iOS 17 e 18\n• Supporto ottimizzato per iOS 17, 18 e iPadOS\n• Dettagli lezione ridisegnati con layout migliorato\n• Performance generali notevolmente migliorate"
          }
        }
      }
    },
    "v0_9-03-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
