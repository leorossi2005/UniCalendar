    "v0_6-headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "More readable lessons and new icon"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Lezioni più leggibili e nuova icona"
