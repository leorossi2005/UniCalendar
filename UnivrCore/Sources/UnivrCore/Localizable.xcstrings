            "value" : "Miglioramenti e Correzioni"
          }
        }
      }
    },
    "v0_2-headline" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swipe through days and new calendar"
          }
        },
        "it" : {
