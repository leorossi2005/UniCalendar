            "value" : "Sezione Donazioni"
          }
        }
      }
    },
    "v0_8-01-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The course selection interface has been completely rewritten as a dedicated component shared between onboarding and settings. The search bar now has a clear button, results load more smoothly and the style has been unified with adaptive backgrounds matching the system theme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'interfaccia di selezione del corso è stata completamente riscritta in un componente dedicato condiviso tra onboarding e impostazioni. La barra di ricerca ora ha un pulsante per cancellare il testo, i risultati si caricano in modo più fluido e lo stile è stato uniformato con sfondi adattivi al tema del sistema."
          }
        }
      }
    },
    "v0_8-01-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Course search has been rethought from scratch with a new component."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "La ricerca del corso è stata ripensata da zero con un nuovo componente."
          }
        }
      }
    },
    "v0_8-01-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redesigned Course Selection"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Selezione Corso Ridisegnata"
          }
        }
      }
    },
    "v0_8-02-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar organization, date picker generation and all cache read/write operations now run in the background. Lesson fields such as duration, clean name and tags are pre-computed on load, making scrolling instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'organizzazione del calendario, la generazione del date picker e tutte le operazioni di lettura e scrittura della cache vengono ora eseguite in background. I campi delle lezioni come durata, nome pulito e tag sono pre-calcolati al caricamento, rendendo lo scorrimento istantaneo."
          }
        }
      }
    },
    "v0_8-02-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data processing now happens entirely in the background."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "L'elaborazione dei dati avviene ora interamente in background."
          }
        }
      }
    },
    "v0_8-02-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Background Performance"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Prestazioni in Background"
          }
        }
      }
    },
    "v0_8-03-long" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Simplified navigation: ContentView and RootView merged into a single view\n• Updated to Swift 6.2 with Strict Concurrency for greater stability\n• Cache converted to actor for guaranteed thread safety\n• Onboarding and settings logic unified in a shared component\n• Credits on the Info page are now interactive with portfolio links\n• Improved loading placeholder with more elements and renewed shimmer\n• Smoother onboarding animations with snappy transitions\n• App constants centralized for easier maintenance"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "• Navigazione semplificata: ContentView e RootView unite in un'unica vista\n• Aggiornamento a Swift 6.2 con Strict Concurrency per maggiore stabilità\n• Cache convertita in actor per sicurezza tra thread garantita\n• Logica di onboarding e impostazioni unificata in un componente condiviso\n• Crediti nella pagina Info ora interattivi con link al portfolio\n• Placeholder di caricamento migliorato con più elementi e shimmer rinnovato\n• Animazioni più fluide nell'onboarding con transizioni snappy\n• Costanti dell'app centralizzate per una manutenzione più semplice"
          }
        }
      }
    },
    "v0_8-03-short" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renewed architecture, smooth animations and many fixes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Architettura rinnovata, animazioni fluide e tanti fix."
          }
        }
      }
    },
    "v0_8-03-title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
